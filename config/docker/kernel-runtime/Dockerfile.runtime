FROM node:24-bookworm@sha256:6dac556d980b7f0e5498d08f08cee0ca67798b4ad6c23964a9214920e67758d0 AS node-toolchain

FROM ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    dbus-x11 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatspi2.0-0 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnss3 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxss1 \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

COPY --from=node-toolchain /usr/local /usr/local
RUN npm install --global @openai/codex@0.154.0

RUN useradd --create-home --uid 1000 --shell /bin/bash orca \
  && install -d -o orca -g orca /workspace /output

ARG ORCA_APPIMAGE_SHA256
COPY orca-linux.AppImage /opt/orca/orca-linux.AppImage
RUN test -n "$ORCA_APPIMAGE_SHA256" \
  && printf '%s  %s\n' "$ORCA_APPIMAGE_SHA256" /opt/orca/orca-linux.AppImage | sha256sum -c - \
  && chmod 755 /opt/orca/orca-linux.AppImage \
  && cd /opt/orca \
  && ./orca-linux.AppImage --appimage-extract \
  && rm /opt/orca/orca-linux.AppImage \
  && chown -R orca:orca /opt/orca

COPY run-orca-runtime.sh /usr/local/bin/run-orca-runtime
RUN sed -i 's/\r$//' /usr/local/bin/run-orca-runtime \
  && chmod 755 /usr/local/bin/run-orca-runtime \
  && touch /home/orca/.runtime-volume /workspace/.runtime-volume /output/.runtime-volume \
  && chown -R orca:orca /home/orca /workspace /output

ENV HOME=/home/orca
ENV XDG_CONFIG_HOME=/home/orca/.config
ENV XDG_CACHE_HOME=/home/orca/.cache

USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/run-orca-runtime"]
